{
  "name": "@mono-agent/docs-mcp",
  "version": "0.15.0",
  "description": "Offline search and guided reading over version-matched mono-agent documentation and composer references through MCP.",
  "type": "module",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertsreberski/mono-agent.git",
    "directory": "extras/docs-mcp"
  },
  "private": false,
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mono-agent-docs-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm run generate:corpus",
    "generate:corpus": "node scripts/generate-corpus.mjs",
    "smoke": "node scripts/smoke-packed.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@yarflam/potion-base-8m": "1.0.4",
    "github-slugger": "2.0.0",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
