{
  "name": "mono-agent",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "description": "Small agent framework building blocks under the @mono-agent scope.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=10.16.0"
  },
  "scripts": {
    "pnpm:devPreinstall": "node scripts/node-version.mjs && node scripts/pnpm-release-age-policy.mjs",
    "preinstall": "node scripts/node-version.mjs && node scripts/pnpm-release-age-policy.mjs",
    "build": "pnpm -r --sort run build",
    "check:node": "node scripts/node-version.mjs",
    "check:pnpm-policy": "node scripts/pnpm-release-age-policy.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:oss-hygiene": "node scripts/check-oss-hygiene.mjs",
    "check:licenses": "node scripts/check-license-consistency.mjs && node scripts/check-spdx-headers.mjs",
    "check:lint": "eslint .",
    "check:spdx-headers": "node scripts/check-spdx-headers.mjs",
    "check:dependency-vulnerabilities": "node scripts/check-dependency-vulnerabilities.mjs",
    "check:v1-dependency-vulnerabilities": "node scripts/check-dependency-vulnerabilities.mjs",
    "check:codex-discoverability": "node scripts/check-codex-discoverability.mjs",
    "check:consumer-docs-consistency": "node scripts/check-consumer-docs-consistency.mjs",
    "check:getting-started-version-pins": "node scripts/check-getting-started-version-pins.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:source-line-length": "node scripts/check-source-line-length.mjs",
    "check:source-beta-budgets": "node --experimental-strip-types scripts/check-source-beta-budgets.mjs",
    "check:source-beta-docs": "node --experimental-strip-types scripts/generate-source-beta-docs.mjs --check",
    "check:doc-snippets": "node scripts/check-doc-snippets.mjs",
    "check:architecture": "node scripts/check-package-architecture.mjs",
    "check:deep-imports": "node scripts/verify-deep-imports.mjs",
    "verify:consumers": "node scripts/verify-consumers.mjs",
    "verify:all": "node scripts/verify-all.mjs",
    "verify:v1-minimal": "node scripts/verify-v1-minimal-consumer.mjs",
    "verify:v1-operator-products": "node scripts/verify-v1-operator-products.mjs",
    "verify:v1-system": "node scripts/verify-v1-system.mjs",
    "generate:public-api-docs": "node scripts/generate-public-api-docs.mjs",
    "generate:package-docs": "node scripts/generate-package-docs.mjs",
    "generate:source-beta-docs": "node --experimental-strip-types scripts/generate-source-beta-docs.mjs",
    "report:source-beta": "node --experimental-strip-types scripts/report-source-beta.mjs",
    "typecheck": "pnpm -r --sort run typecheck",
    "test": "pnpm -r --sort run test",
    "release:guard": "node scripts/release/check-publish-guard.mjs",
    "release:validate": "node scripts/release/validate-release.mjs",
    "release:pack": "node scripts/release/pack-release.mjs",
    "release:consumer": "node scripts/release/verify-packed-consumer.mjs",
    "release:publish": "node scripts/release/publish-release.mjs",
    "release:verify": "node scripts/release/verify-release.mjs",
    "scripts:test": "vitest run scripts/__tests__/build-provenance.test.mjs scripts/__tests__/check-codex-discoverability.test.mjs scripts/__tests__/check-consumer-docs-consistency.test.mjs scripts/__tests__/check-dependency-vulnerabilities.test.mjs scripts/__tests__/check-license-consistency.test.mjs scripts/__tests__/check-oss-hygiene.test.mjs scripts/__tests__/check-package-architecture.test.mjs scripts/__tests__/check-secrets.test.mjs scripts/__tests__/check-source-line-length.test.mjs scripts/__tests__/check-spdx-headers.test.mjs scripts/__tests__/check-starlight-asides.test.mjs scripts/__tests__/community-files.test.mjs scripts/__tests__/doc-snippets.test.mjs scripts/__tests__/docs-mcp-smoke-packed.test.mjs scripts/__tests__/docs-quality.test.mjs scripts/__tests__/gate-coverage.test.mjs scripts/__tests__/getting-started-version-pins.test.mjs scripts/__tests__/gitleaks-config.test.mjs scripts/__tests__/mutate.test.mjs scripts/__tests__/node-version.test.mjs scripts/__tests__/package-docs.test.mjs scripts/__tests__/package-verification.test.mjs scripts/__tests__/pnpm-release-age-policy.test.mjs scripts/__tests__/public-api-docs.test.mjs scripts/__tests__/readme-quickstart-boundary.test.mjs scripts/__tests__/repo-hygiene-skills.test.mjs scripts/__tests__/source-beta-report.test.mjs scripts/__tests__/verify-all.test.mjs scripts/__tests__/verify-consumers.test.mjs scripts/__tests__/verify-deep-imports.test.mjs scripts/__tests__/verify-v1-system-proof.test.mjs scripts/__tests__/website-ci.test.mjs",
    "release:test:unit": "vitest run scripts/release/__tests__/release.test.mjs scripts/release/__tests__/package-count-drift.test.mjs",
    "release:test": "pnpm run release:test:unit && vitest run scripts/release/__tests__/packed-consumer.test.mjs",
    "mutate": "node scripts/mutate.mjs",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mono-agent/channel-openai-api": "workspace:0.15.0",
    "@mono-agent/channel-operator": "workspace:0.15.0",
    "@mono-agent/channel-slack": "workspace:0.15.0",
    "@mono-agent/channel-telegram": "workspace:0.15.0",
    "@mono-agent/channel-webhook": "workspace:0.15.0",
    "@mono-agent/cli": "workspace:0.15.0",
    "@mono-agent/core": "workspace:0.15.0",
    "@mono-agent/docs-mcp": "workspace:0.15.0",
    "@mono-agent/exporter-otlp": "workspace:0.15.0",
    "@mono-agent/memory-local": "workspace:0.15.0",
    "@mono-agent/module-sdk": "workspace:0.15.0",
    "@mono-agent/operator": "workspace:0.15.0",
    "@mono-agent/runtime-claude": "workspace:0.15.0",
    "@mono-agent/runtime-codex": "workspace:0.15.0",
    "@mono-agent/runtime-opencode": "workspace:0.15.0",
    "@mono-agent/runtime-pi": "workspace:0.15.0",
    "@mono-agent/sandbox-srt": "workspace:0.15.0",
    "@mono-agent/service-macos": "workspace:0.15.0",
    "@mono-agent/state-local": "workspace:0.15.0",
    "@mono-agent/trigger-cron": "workspace:0.15.0",
    "@mono-agent/tui": "workspace:0.15.0",
    "@mono-agent/web": "workspace:0.15.0",
    "@playwright/test": "1.61.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "^22.15.18",
    "@vitest/coverage-v8": "3.2.4",
    "create-mono-agent": "workspace:0.15.0",
    "eslint": "^9.39.5",
    "fast-check": "4.9.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.1.4",
    "yaml": "^2.9.0"
  }
}
