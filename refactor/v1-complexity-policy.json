{
  "schema": "mono-agent.v1-complexity-policy.v1",
  "algorithmVersion": 1,
  "sourceExtensions": [
    ".cjs",
    ".cts",
    ".js",
    ".jsx",
    ".mjs",
    ".mts",
    ".ts",
    ".tsx"
  ],
  "testPathSegments": [
    "__fixtures__",
    "__tests__",
    "fixtures",
    "test",
    "testdata",
    "tests"
  ],
  "testFilenameMarkers": [
    ".spec.",
    ".test.",
    "vitest.config."
  ],
  "productionRoots": [
    "extras/",
    "packages/"
  ],
  "generatedRules": [],
  "vendoredRules": [],
  "excludedRules": [
    {
      "id": "typescript-declaration-only",
      "reason": "Type-only declarations are not executable production source.",
      "match": {
        "suffixes": [
          ".d.cts",
          ".d.mts",
          ".d.ts"
        ]
      }
    }
  ],
  "nonShippingRules": [
    {
      "id": "repository-tooling",
      "reason": "Repository verification and build tooling is reported but is outside the shipped-package production budget.",
      "match": {
        "paths": [
          "vitest.config.mjs"
        ],
        "prefixes": [
          "scripts/"
        ]
      }
    },
    {
      "id": "non-shipping-demo",
      "reason": "Demonstration source is reported but is not part of a published package.",
      "match": {
        "prefixes": [
          "demos/"
        ]
      }
    },
    {
      "id": "documentation-site",
      "reason": "The separately deployed documentation site is reported but is outside the shipped-package production budget.",
      "match": {
        "prefixes": [
          "website/"
        ]
      }
    }
  ],
  "budgets": [
    {
      "id": "repository-production",
      "classification": "production",
      "maxLines": 130000,
      "enforceAt": "G8"
    },
    {
      "id": "kernel-production",
      "classification": "production",
      "owners": [
        "packages/cli",
        "packages/core",
        "packages/module-sdk"
      ],
      "maxLines": 15000,
      "enforceAt": "G8",
      "requireOwners": true
    }
  ],
  "configSchemaPath": "packages/agent-app/schema/mono-agent.config.schema.json",
  "closures": [
    {
      "id": "v0-create-mono-agent",
      "roots": [
        "create-mono-agent"
      ]
    }
  ],
  "knownNativeDependencies": [
    "better-sqlite3",
    "sqlite-vec"
  ],
  "implementationFamilies": [
    {
      "id": "operator-wire-client",
      "members": [
        "packages/tui/src/remote/client.ts",
        "packages/web/src/operator-client.ts"
      ],
      "maxMembers": 1,
      "enforceAt": "G8"
    }
  ]
}
