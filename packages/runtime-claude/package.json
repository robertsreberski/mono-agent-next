{
  "name": "@mono-agent/runtime-claude",
  "version": "0.15.0",
  "description": "Claude Agent SDK and CLI runtime module for mono-agent v1.",
  "type": "module",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertsreberski/mono-agent-next.git",
    "directory": "packages/runtime-claude"
  },
  "keywords": ["ai", "agents", "mono-agent", "runtime", "claude"],
  "mono-agent": {
    "packageName": "@mono-agent/runtime-claude",
    "apiVersion": 1,
    "kind": "runtime",
    "responsibility": "Runs Claude-native turns through explicit SDK or CLI transports."
  },
  "private": false,
  "engines": { "node": ">=22.19.0" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.206",
    "@mono-agent/module-sdk": "workspace:0.15.0"
  },
  "publishConfig": { "access": "public" }
}
