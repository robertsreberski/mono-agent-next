{
  "name": "@mono-agent/sandbox-srt",
  "version": "0.15.0",
  "description": "Integrity-pinned SRT sandbox module for mono-agent v1.",
  "type": "module",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertsreberski/mono-agent-next.git",
    "directory": "packages/sandbox-srt"
  },
  "keywords": [
    "ai",
    "agents",
    "mono-agent",
    "sandbox",
    "srt"
  ],
  "mono-agent": {
    "packageName": "@mono-agent/sandbox-srt",
    "apiVersion": 1,
    "kind": "sandbox",
    "responsibility": "Executes selected commands through a fingerprinted fail-closed Sandbox Runtime Tool boundary."
  },
  "private": false,
  "sideEffects": false,
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mono-agent/module-sdk": "workspace:0.15.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
