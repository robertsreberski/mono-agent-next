{
  "name": "@mono-agent/channel-webhook",
  "version": "0.15.0",
  "description": "Authenticated HTTP webhook channel for mono-agent.",
  "type": "module",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertsreberski/mono-agent-next.git",
    "directory": "packages/channel-webhook"
  },
  "private": false,
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "mono-agent": {
    "packageName": "@mono-agent/channel-webhook",
    "apiVersion": 1,
    "kind": "channel",
    "responsibility": "Accepts authenticated HTTP invocations and submits normalized inbound turns."
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mono-agent/module-sdk": "workspace:0.15.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
