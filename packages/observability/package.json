{
  "name": "@mono-agent/observability",
  "version": "0.15.0",
  "description": "Run event recording and artifact summaries for agent hosts.",
  "type": "module",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertsreberski/mono-agent.git",
    "directory": "packages/observability"
  },
  "private": false,
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./event-timeline": {
      "types": "./dist/event-timeline.d.ts",
      "import": "./dist/event-timeline.js"
    },
    "./run-export": {
      "types": "./dist/run-export-mapping.d.ts",
      "import": "./dist/run-export-mapping.js"
    },
    "./otel": {
      "types": "./dist/otel/index.d.ts",
      "import": "./dist/otel/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mono-agent/agent-contracts": "workspace:0.15.0",
    "@opentelemetry/otlp-transformer": "0.219.0",
    "@opentelemetry/sdk-trace-base": "2.8.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
