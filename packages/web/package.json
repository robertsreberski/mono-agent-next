{
  "name": "@mono-agent/web",
  "version": "0.15.0",
  "description": "Standalone browser operator with explicit token or trusted-network access for mono-agent instances.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertsreberski/mono-agent-next.git",
    "directory": "packages/web"
  },
  "private": false,
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mono-agent-web": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "webapp/dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm run build:webapp && tsc -p tsconfig.build.json",
    "build:webapp": "vite build --config webapp/vite.config.ts",
    "dev:webapp": "vite --config webapp/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p webapp/tsconfig.json --noEmit",
    "test": "pnpm run build:webapp && vitest run --expect.requireAssertions"
  },
  "dependencies": {
    "@mono-agent/operator": "workspace:0.15.0"
  },
  "devDependencies": {
    "@assistant-ui/react": "0.14.27",
    "@assistant-ui/react-markdown": "0.14.6",
    "@base-ui/react": "1.6.0",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "4.7.0",
    "cmdk": "1.1.1",
    "jsdom": "26.1.0",
    "react": "19.2.8",
    "react-dom": "19.1.0",
    "vite": "6.3.5",
    "vite-plugin-pwa": "0.21.2",
    "workbox-window": "7.4.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
