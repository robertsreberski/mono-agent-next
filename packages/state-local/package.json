{
  "name": "@mono-agent/state-local",
  "version": "0.15.0",
  "description": "Owner-private durable local state module for mono-agent.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertsreberski/mono-agent-next.git",
    "directory": "packages/state-local"
  },
  "keywords": [
    "ai",
    "agents",
    "mono-agent",
    "state",
    "durability"
  ],
  "mono-agent": {
    "packageName": "@mono-agent/state-local",
    "apiVersion": 1,
    "kind": "state",
    "responsibility": "Provides owner-private CAS state, durable transcript/run records, RunHistory, idempotency, and presence publication."
  },
  "private": false,
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mono-agent/module-sdk": "workspace:0.15.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
