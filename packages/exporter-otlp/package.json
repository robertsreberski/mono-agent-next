{
  "name": "@mono-agent/exporter-otlp",
  "version": "0.15.0",
  "description": "Bounded, credential-safe OTLP exporter module for mono-agent.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertsreberski/mono-agent-next.git",
    "directory": "packages/exporter-otlp"
  },
  "keywords": [
    "ai",
    "agents",
    "mono-agent",
    "otlp",
    "observability"
  ],
  "mono-agent": {
    "packageName": "@mono-agent/exporter-otlp",
    "apiVersion": 1,
    "kind": "exporter",
    "responsibility": "Exports bounded normalized telemetry batches to an OTLP HTTP endpoint."
  },
  "private": false,
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --expect.requireAssertions"
  },
  "dependencies": {
    "@mono-agent/module-sdk": "workspace:0.15.0",
    "@opentelemetry/otlp-transformer": "0.219.0",
    "@opentelemetry/sdk-trace-base": "2.8.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
