{
  "name": "create-mono-agent",
  "version": "0.15.0",
  "description": "Transactional minimal, personal, and multi-runtime mono-agent project scaffolder.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertsreberski/mono-agent-next.git",
    "directory": "packages/create-mono-agent"
  },
  "private": false,
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "create-mono-agent": "./dist/bin/create-mono-agent.js",
    "mono-agent": "./dist/bin/mono-agent.js"
  },
  "files": [
    "dist",
    "skills",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mono-agent/cli": "workspace:0.15.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
