{
  "name": "@mono-agent/tui",
  "version": "0.15.0",
  "description": "Standalone pi-tui operator console over the shared mono-agent operator protocol.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertsreberski/mono-agent-next.git",
    "directory": "packages/tui"
  },
  "private": false,
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "mono-agent-tui": "./dist/bin/mono-agent-tui.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --expect.requireAssertions"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "0.79.10",
    "@mono-agent/operator": "workspace:0.15.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
