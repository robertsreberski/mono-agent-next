{
  "name": "@mono-agent/module-sdk",
  "version": "0.15.0",
  "description": "Typed module contracts, schema provenance, and compliance helpers for mono-agent extensions.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertsreberski/mono-agent-next.git",
    "directory": "packages/module-sdk"
  },
  "private": false,
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./secure-fs": {
      "types": "./dist/secure-fs.d.ts",
      "import": "./dist/secure-fs.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --expect.requireAssertions"
  },
  "publishConfig": {
    "access": "public"
  }
}
